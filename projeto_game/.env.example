# Copie para .env e ajuste os valores. Nunca versione o .env real.

NODE_ENV=development
PORT=8200

MONGODB_URI=mongodb://127.0.0.1:27017/got
MONGODB_DB=got

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres
SESSION_NAME=got.sid

# Usuários que podem acessar a área administrativa, separados por vírgula.
ADMIN_USERS=seu_usuario
