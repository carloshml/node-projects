<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG - Game of Thrones</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link href="css/style.css" rel="stylesheet">
	<script src="jsView/som.js" defer></script>
	<script src="jsView/jogoView.js" defer></script>
</head>

<body class="body-jogo">
	<nav class="navbar navbar-jogo">
		<div class="container-fluid d-flex justify-content-between align-items-center">
			<a class="navbar-brand" href="/home">
				<img src="images/casa_<%=img_casa%>.jpg" width="30" height="30"
					class="display-logo align-text-top" alt="">
				Este é seu jogo, <%=jogo.nome%>!
			</a>

			<div class="d-flex align-items-center gap-2">
				<button id="btn-som" type="button" class="btn btn-sm btn-outline-secondary"
					aria-pressed="false">Som: off</button>
				<a href="/sair" id="btn-sair" class="btn btn-info btn-sm">Sair</a>
			</div>
		</div>
	</nav>

	<div class="hud-jogo">
		<div class="hud-grupo hud-grupo--recursos">
			<div class="hud-item" title="Moedas">
				<img src="images/icones/moeda.svg" alt="" class="hud-icone">
				<span class="hud-rotulo">moedas</span>
				<span class="hud-valor" id="hud-moeda"><%=jogo.moeda%></span>
			</div>

			<div class="hud-item" title="Aldeões livres / total">
				<img src="images/icones/aldeao.svg" alt="" class="hud-icone">
				<span class="hud-rotulo">aldeões</span>
				<span class="hud-valor" id="hud-suditos-livres"><%=jogo.suditos - jogo.suditosTrabalhando%></span>
				<span class="hud-sep">/</span>
				<span class="hud-valor" id="hud-suditos-total"><%=jogo.suditos%></span>
				<span class="hud-extra" id="hud-suditos-trabalhando"><%=jogo.suditosTrabalhando%> trab.</span>
			</div>

			<div class="hud-item" title="Madeira">
				<img src="images/icones/madeira.svg" alt="" class="hud-icone">
				<span class="hud-rotulo">madeira</span>
				<span class="hud-valor" id="hud-madeira"><%=jogo.recursos.madeira || 0%></span>
			</div>

			<div class="hud-item" title="Comida">
				<img src="images/icones/comida.svg" alt="" class="hud-icone">
				<span class="hud-rotulo">comida</span>
				<span class="hud-valor" id="hud-comida"><%=jogo.recursos.comida || 0%></span>
			</div>

			<div class="hud-item" title="Ferro">
				<img src="images/icones/ferro.svg" alt="" class="hud-icone">
				<span class="hud-rotulo">ferro</span>
				<span class="hud-valor" id="hud-ferro"><%=jogo.recursos.ferro || 0%></span>
			</div>
		</div>

		<span class="hud-divisor" aria-hidden="true"></span>

		<div class="hud-grupo hud-grupo--habilidades">
			<div class="hud-item hud-item--habilidade" title="Temor">
				<img src="images/habilidades/temor.jpg" alt="" class="hud-icone hud-icone--redondo">
				<span class="hud-rotulo">temor</span>
				<span class="hud-valor" id="valor-temor"><%=jogo.temor%></span>
			</div>

			<div class="hud-item hud-item--habilidade" title="Sabedoria">
				<img src="images/habilidades/sabedoria.jpg" alt="" class="hud-icone hud-icone--redondo">
				<span class="hud-rotulo">sabedoria</span>
				<span class="hud-valor" id="valor-sabedoria"><%=jogo.sabedoria%></span>
			</div>

			<div class="hud-item hud-item--habilidade" title="Comércio">
				<img src="images/habilidades/comercio.jpg" alt="" class="hud-icone hud-icone--redondo">
				<span class="hud-rotulo">comércio</span>
				<span class="hud-valor" id="valor-comercio"><%=jogo.comercio%></span>
			</div>

			<div class="hud-item hud-item--habilidade" title="Magia">
				<img src="images/habilidades/magia.jpg" alt="" class="hud-icone hud-icone--redondo">
				<span class="hud-rotulo">magia</span>
				<span class="hud-valor" id="valor-magia"><%=jogo.magia%></span>
			</div>
		</div>
	</div>

	<section>
		<div class="row">
			<div class="col-sm-1"></div>

			<div class="col-sm-4">
				<div id="acoes" class="acoes">
					<p class="acoes-carregando">Carregando ordens...</p>
				</div>

				<div id="celeiro" class="celeiro">
					<h4>Celeiro</h4>
					<p class="celeiro-dica">Venda os recursos da coleta para ganhar moedas. Comércio valoriza o preço.</p>
					<div id="lista-recursos"></div>
				</div>
			</div>

			<div class="col-sm-6">
				<div id="pergaminhos" class="pergaminhos"></div>

				<button type="button" id="btn-comprar-aldeao" class="btn-comprar-aldeao"
					onclick="comprarAldeao()"
					title="Comprar um novo aldeão por 10.000 moedas">
					<span class="btn-comprar-aldeao__rotulo">Contratar aldeão</span>
					<span class="btn-comprar-aldeao__retrato">
						<img class="btn-comprar-aldeao__aldeao" src="images/walk.gif" alt="">
					</span>
					<span class="btn-comprar-aldeao__custo">10.000 moedas</span>
				</button>
			</div>

			<div class="col-sm-1"></div>
		</div>
	</section>

	<div class="barra-inferior">
		<div class="toolbar-jogo">
			<button type="button" class="toolbar-botao" onclick="irParaOrdens()">
				<img src="images/outros/suditos.jpg" alt=""> Ordenar
			</button>

			<button type="button" class="toolbar-botao" onclick="irParaCeleiro()">
				<img src="images/icones/madeira.svg" alt=""> Celeiro
			</button>

			<button type="button" class="toolbar-botao" onclick="verPergaminhos()">
				<img src="images/outros/pergaminho.jpg" alt=""> Pergaminhos
			</button>

			<button type="button" class="toolbar-botao" onclick="abrirSonsBatalha()">
				<span class="toolbar-nota" aria-hidden="true">♪</span> Sons da batalha
			</button>
		</div>
	</div>

	<div id="mensagens" aria-live="assertive" aria-atomic="true"></div>

	<div id="som-batalha-modal" class="som-batalha-modal" hidden>
		<div class="som-batalha-painel" role="dialog" aria-modal="true" aria-labelledby="som-batalha-titulo">
			<header class="som-batalha-topo">
				<div>
					<p class="som-batalha-eyebrow">Trilha da caçada</p>
					<h2 id="som-batalha-titulo">Sons da batalha</h2>
				</div>
				<button type="button" class="som-batalha-fechar" onclick="fecharSonsBatalha()"
					aria-label="Fechar sons da batalha">×</button>
			</header>

			<p class="som-batalha-intro">
				Escolha o som dos guerreiros e o da fera. Durante a caçada, os dois se alternam.
			</p>

			<div class="som-batalha-colunas">
				<section>
					<h3>Guerreiros</h3>
					<div id="opcoes-guerreiros" class="som-opcoes"></div>
				</section>

				<section>
					<h3>Fera</h3>
					<div id="opcoes-feras" class="som-opcoes"></div>
				</section>
			</div>

			<footer class="som-batalha-rodape">
				<small>As escolhas ficam salvas neste navegador.</small>
				<div class="som-batalha-acoes">
					<button type="button" id="btn-mudo-batalha" class="som-batalha-mudo"
						onclick="alternarSomBatalha()">Som: on</button>
					<button type="button" class="btn btn-sm som-batalha-pronto" onclick="fecharSonsBatalha()">Pronto</button>
				</div>
			</footer>
		</div>
	</div>
</body>

</html>
