<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG-GOT | Administração</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link rel="stylesheet" href="css/style.css">
</head>

<body class="body-admin">
	<%
	const CASAS = {
		arryn: 'Arryn',
		baratheon: 'Baratheon',
		greyjoy: 'Greyjoy',
		lannister: 'Lannister',
		martell: 'Martell',
		stark: 'Stark',
		targaryen: 'Targaryen',
		tully: 'Tully',
		tyrell: 'Tyrell'
	};

	function nomeCasa(slug) {
		return CASAS[slug] || (slug ? slug.charAt(0).toUpperCase() + slug.slice(1) : 'Sem casa');
	}

	const usuarios = resultados || [];
	const erros = validacao || [];
	const casaAtual = img_casa || 'stark';
	const opcoesCasas = [
		{ slug: 'arryn', nome: 'Arryn' },
		{ slug: 'baratheon', nome: 'Baratheon' },
		{ slug: 'greyjoy', nome: 'Greyjoy' },
		{ slug: 'lannister', nome: 'Lannister' },
		{ slug: 'martell', nome: 'Martell' },
		{ slug: 'stark', nome: 'Stark' },
		{ slug: 'targaryen', nome: 'Targaryen' },
		{ slug: 'tully', nome: 'Tully' },
		{ slug: 'tyrell', nome: 'Tyrell' }
	];
	%>

	<nav class="navbar navbar-admin">
		<div class="container-fluid admin-navbar">
			<a class="navbar-brand" href="/home">
				<img src="images/casa_<%=casaAtual%>.jpg" width="34" height="34" alt="">
				<span>
					<strong>Administração</strong>
					<small>Painel de contas</small>
				</span>
			</a>

			<div class="admin-navbar__acoes">
				<span class="admin-navbar__usuario"><%=nome%></span>
				<a href="/sair" id="btn-sair" class="btn btn-sm btn-admin-sair">Sair</a>
			</div>
		</div>
	</nav>

	<main class="admin-pagina">
		<header class="admin-hero">
			<div>
				<p class="admin-hero__eyebrow">Área administrativa</p>
				<h1>Usuários</h1>
				<p class="admin-hero__texto">Gerencie as contas cadastradas no sistema.</p>
			</div>

			<button id="btn-create-usuario" class="btn btn-admin-primary" data-bs-toggle="modal"
				data-bs-target="#modal-create">
				+ Novo usuário
			</button>
		</header>

		<section class="admin-painel">
			<div class="admin-painel__topo">
				<div class="admin-contagem">
					<strong><%=usuarios.length%></strong>
					<span>conta<%=usuarios.length === 1 ? '' : 's'%></span>
				</div>

				<div class="admin-busca">
					<input id="busca-usuarios" class="form-control admin-busca__campo" type="search"
						placeholder="Filtrar por nome, usuário ou casa" aria-label="Filtrar usuários">
				</div>
			</div>

			<% if (usuarios.length) { %>
				<div class="admin-tabela">
					<div class="admin-tabela__cabecalho">
						<span>Usuário</span>
						<span class="admin-col-casa">Casa</span>
						<span class="admin-col-acao">Ações</span>
					</div>

					<% for (var i = 0; i < usuarios.length; i++) {
						var usuario = usuarios[i];
						var casa = usuario.casa || 'stark';
						var busca = (usuario.nome + ' ' + usuario.usuario + ' ' + nomeCasa(casa)).toLowerCase();
					%>
						<div class="admin-linha" data-busca="<%=busca%>">
							<div class="admin-pessoa">
								<span class="admin-avatar"><%= (usuario.nome || '?').charAt(0).toUpperCase() %></span>
								<span class="admin-pessoa__dados">
									<strong><%=usuario.nome%></strong>
									<small>@<%=usuario.usuario%></small>
								</span>
							</div>

							<span class="admin-casa admin-col-casa">
								<img src="images/casa_<%=casa%>.jpg" alt="">
								Casa <%=nomeCasa(casa)%>
							</span>

							<div class="admin-col-acao">
								<button type="button" class="btn btn-sm btn-admin-editar btn-editar"
									data-bs-toggle="modal" data-bs-target="#modal-update"
									data-id="<%=usuario._id%>"
									data-nome="<%=usuario.nome%>"
									data-usuario="<%=usuario.usuario%>">
									Editar
								</button>
							</div>
						</div>
					<% } %>
				</div>
			<% } %>

			<div id="admin-vazio" class="admin-vazio"<%=usuarios.length ? ' hidden' : ''%>>
				<p>Nenhum usuário cadastrado ainda.</p>
				<small>Use “Novo usuário” para criar a primeira conta.</small>
			</div>
		</section>
	</main>

	<input type="hidden" id="tem-validacao" value="<%=erros.length > 0 ? 'S' : 'F'%>">

	<!-- Editar usuário -->
	<div class="modal fade" id="modal-update" tabindex="-1" aria-labelledby="modal-update-label" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content admin-modal">
				<form id="form-update" action="/atualizarUsuario" method="post">
					<div class="modal-header">
						<h2 class="modal-title h5" id="modal-update-label">Editar usuário</h2>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
					</div>

					<div class="modal-body">
						<input type="hidden" name="_id" id="update-id">

						<div class="mb-3">
							<label for="update-id-display" class="form-label">Código</label>
							<input id="update-id-display" class="form-control" type="text" disabled>
						</div>

						<div class="mb-3">
							<label for="update-nome" class="form-label">Nome</label>
							<input id="update-nome" name="nome" class="form-control" type="text" required>
						</div>

						<div class="mb-3">
							<label for="update-usuario" class="form-label">Usuário</label>
							<input id="update-usuario" name="usuario" class="form-control" type="text" required>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-admin-secundario" data-bs-dismiss="modal">Cancelar</button>
						<button type="submit" class="btn btn-admin-primary">Salvar alterações</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Novo usuário -->
	<div class="modal fade" id="modal-create" tabindex="-1" aria-labelledby="modal-create-label" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content admin-modal">
				<form action="/inserirUsuarioCrud" method="post">
					<div class="modal-header">
						<h2 class="modal-title h5" id="modal-create-label">Novo usuário</h2>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
					</div>

					<div class="modal-body">
						<% if (erros.length > 0) { %>
							<div class="alert alert-danger">
								<strong>Não foi possível salvar</strong>
								<ul class="mb-0">
									<% for (var i = 0; i < erros.length; i++) { %>
										<li><%=erros[i].msg%></li>
									<% } %>
								</ul>
							</div>
						<% } %>

						<div class="row g-3">
							<div class="col-12 col-md-6">
								<label for="create-nome" class="form-label">Nome</label>
								<input id="create-nome" name="nome" class="form-control" type="text" required>
							</div>

							<div class="col-12 col-md-6">
								<label for="create-usuario" class="form-label">Usuário</label>
								<input id="create-usuario" name="usuario" class="form-control" type="text" required>
							</div>

							<div class="col-12 col-md-6">
								<label for="create-senha" class="form-label">Senha</label>
								<input id="create-senha" name="senha" class="form-control" type="password" required>
							</div>
						</div>

						<div class="admin-casas-titulo">Casa</div>
						<div class="admin-casas">
							<% for (var c = 0; c < opcoesCasas.length; c++) {
								var opcao = opcoesCasas[c];
							%>
								<label class="admin-casa-opcao">
									<img src="images/casa_<%=opcao.slug%>.jpg" alt="Casa <%=opcao.nome%>">
									<span>Casa <%=opcao.nome%></span>
									<input type="radio" name="casa" value="<%=opcao.slug%>" required>
								</label>
							<% } %>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-admin-secundario" data-bs-dismiss="modal">Cancelar</button>
						<button type="submit" class="btn btn-admin-primary">Criar usuário</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script src="js/bootstrap.bundle.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const modalUpdate = document.getElementById('modal-update');

			modalUpdate.addEventListener('show.bs.modal', function (evento) {
				const botao = evento.relatedTarget;
				if (!botao) {
					return;
				}

				document.getElementById('update-id').value = botao.getAttribute('data-id') || '';
				document.getElementById('update-id-display').value = botao.getAttribute('data-id') || '';
				document.getElementById('update-nome').value = botao.getAttribute('data-nome') || '';
				document.getElementById('update-usuario').value = botao.getAttribute('data-usuario') || '';
			});

			const busca = document.getElementById('busca-usuarios');
			if (busca) {
				busca.addEventListener('input', function () {
					const termo = busca.value.trim().toLowerCase();
					let visiveis = 0;

					document.querySelectorAll('.admin-linha').forEach(function (linha) {
						const combina = !termo || (linha.dataset.busca || '').indexOf(termo) !== -1;
						linha.hidden = !combina;
						if (combina) {
							visiveis++;
						}
					});

					const vazio = document.getElementById('admin-vazio');
					if (vazio) {
						vazio.hidden = visiveis > 0;
						const texto = vazio.querySelector('p');
						if (texto) {
							texto.textContent = termo
								? 'Nenhum usuário corresponde à busca.'
								: 'Nenhum usuário cadastrado ainda.';
						}
					}
				});
			}

			const temValidacao = document.getElementById('tem-validacao');
			if (temValidacao && temValidacao.value === 'S') {
				const modalCreate = bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-create'));
				modalCreate.show();
			}
		});
	</script>
</body>

</html>
