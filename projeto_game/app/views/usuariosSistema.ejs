<% const jogoAtual = (jogo && typeof jogo === 'object') ? jogo : {}; %>
<% const queryJogo = encodeURIComponent(JSON.stringify(jogoAtual)); %>
<% const queryMsg = encodeURIComponent(typeof msg === 'string' ? msg : ''); %>
<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG-GOT | Usuários</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link rel="stylesheet" href="css/style.css">
</head>

<body class="body-index" style="background: white">
	<nav class="navbar bg-light">
		<div class="container d-flex justify-content-between align-items-center">
			<a class="navbar-brand" href="/home">
				<img src="images/casa_<%=img_casa%>.jpg" width="30" height="30"
					class="display-logo align-text-top" alt="">
				Veja os usuários, <%=jogoAtual.nome%>!
			</a>

			<div class="d-flex gap-2">
				<button id="btn-create-usuario" class="btn btn-info" data-bs-toggle="modal"
					data-bs-target="#modal-create">
					Cadastro
				</button>
				<a href="/sair" id="btn-sair" class="btn btn-info">Sair</a>
			</div>
		</div>
	</nav>

	<section class="conteudo-pagina">
		<h1>Veja os usuários</h1>

		<div class="container">
			<div class="row titulo">
				<div class="col-md-5 text-center">nome</div>
				<div class="col-md-5 text-center">usuario</div>
				<div class="col-md-2 text-center"></div>
			</div>

			<% for (var i = 0; i < resultados.length; i++) { %>
				<div class="row elemento align-items-center">
					<div class="col-md-5 text-center">
						<%= resultados[i].nome %>
					</div>
					<div class="col-md-5 text-center">
						<%= resultados[i].usuario %>
					</div>
					<div class="col-md-2 text-center">
						<button type="button" class="btn btn-success btn-sm btn-editar"
							data-bs-toggle="modal" data-bs-target="#modal-update"
							data-id="<%= resultados[i]._id %>"
							data-nome="<%= resultados[i].nome %>"
							data-usuario="<%= resultados[i].usuario %>">
							Editar
						</button>
					</div>
				</div>
			<% } %>
		</div>
	</section>

	<input type="hidden" id="tem-validacao" value="<%= validacao.length > 0 ? 'S' : 'F' %>">

	<!-- Modal de atualização -->
	<div class="modal fade" id="modal-update" tabindex="-1" aria-labelledby="modal-update-label" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<form id="form-update"
					action="/atualizarUsuario?img_casa=<%=img_casa%>&jogo=<%=queryJogo%>&msg=<%=queryMsg%>"
					method="post">
					<div class="modal-header">
						<h5 class="modal-title" id="modal-update-label">Atualizar usuário</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
					</div>

					<div class="modal-body">
						<input type="hidden" name="_id" id="update-id">
						<input type="hidden" name="id_jogo"
							value="img_casa=<%=img_casa%>&jogo=<%=queryJogo%>&msg=<%=queryMsg%>">

						<div class="mb-3">
							<label for="update-id-display" class="form-label">Código</label>
							<input id="update-id-display" class="form-control" type="text" disabled>
						</div>

						<div class="mb-3">
							<label for="update-nome" class="form-label">Nome</label>
							<input id="update-nome" name="nome" class="form-control" type="text" required>
						</div>

						<div class="mb-3">
							<label for="update-usuario" class="form-label">Usuário</label>
							<input id="update-usuario" name="usuario" class="form-control" type="text" required>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
						<button type="submit" class="btn btn-success">Atualizar</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Modal de cadastro -->
	<div class="modal fade" id="modal-create" tabindex="-1" aria-labelledby="modal-create-label" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<form
					action="/inserirUsuarioCrud?img_casa=<%=img_casa%>&jogo=<%=queryJogo%>&msg=<%=queryMsg%>"
					method="post">
					<div class="modal-header">
						<h5 class="modal-title" id="modal-create-label">Novo usuário</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
					</div>

					<div class="modal-body">
						<% if (validacao.length > 0) { %>
							<div class="alert alert-danger">
								<strong>Atenção</strong>
								<ul class="mb-0">
									<% for (var i = 0; i < validacao.length; i++) { %>
										<li><%= validacao[i].msg %></li>
									<% } %>
								</ul>
							</div>
						<% } %>

						<div class="row g-3">
							<div class="col-12 col-md-6">
								<label for="create-nome" class="form-label">Nome</label>
								<input id="create-nome" name="nome" class="form-control" type="text" required>
							</div>

							<div class="col-12 col-md-6">
								<label for="create-usuario" class="form-label">Usuário</label>
								<input id="create-usuario" name="usuario" class="form-control" type="text" required>
							</div>

							<div class="col-12 col-md-6">
								<label for="create-senha" class="form-label">Senha</label>
								<input id="create-senha" name="senha" class="form-control" type="password" required>
							</div>
						</div>

						<div class="row g-2 center mt-3">
							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_arryn.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Arryn">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="arryn" required> Casa Arryn
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_baratheon.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Baratheon">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="baratheon" required> Casa Baratheon
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_greyjoy.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Greyjoy">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="greyjoy" required> Casa Greyjoy
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_lannister.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Lannister">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="lannister" required> Casa Lannister
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_martell.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Martell">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="martell" required> Casa Martell
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_stark.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Stark">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="stark" required> Casa Stark
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_targaryen.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Targaryen">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="targaryen" required> Casa Targaryen
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_tully.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Tully">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="tully" required> Casa Tully
								</label>
							</div>

							<div class="col-6 col-sm-4 col-md-3">
								<img src="images/casa_tyrell.jpg" class="img-fluid img-radio tam-img-crud" alt="Casa Tyrell">
								<label class="d-block text-center">
									<input type="radio" name="casa" value="tyrell" required> Casa Tyrell
								</label>
							</div>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
						<button type="submit" class="btn btn-success">Salvar</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script src="js/bootstrap.bundle.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const modalUpdate = document.getElementById('modal-update');

			modalUpdate.addEventListener('show.bs.modal', function (evento) {
				const botao = evento.relatedTarget;
				if (!botao) {
					return;
				}

				document.getElementById('update-id').value = botao.getAttribute('data-id') || '';
				document.getElementById('update-id-display').value = botao.getAttribute('data-id') || '';
				document.getElementById('update-nome').value = botao.getAttribute('data-nome') || '';
				document.getElementById('update-usuario').value = botao.getAttribute('data-usuario') || '';
			});

			const temValidacao = document.getElementById('tem-validacao');
			if (temValidacao && temValidacao.value === 'S') {
				const modalCreate = bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-create'));
				modalCreate.show();
			}
		});
	</script>
</body>

</html>
