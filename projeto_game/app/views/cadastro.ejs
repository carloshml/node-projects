<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG - Game of Thrones</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link href="css/style.css" rel="stylesheet">
</head>

<body class="body-index">
	<nav class="navbar bg-light">
		<div class="container">
			<a href="/" class="btn btn-success">Voltar</a>
		</div>
	</nav>

	<div class="container">
		<% if (validacao.length > 0) { %>
			<div class="alert alert-danger">
				<strong>Atenção</strong>
				<ul class="mb-0">
					<% for (var i = 0; i < validacao.length; i++) { %>
						<li><%= validacao[i].msg %></li>
					<% } %>
				</ul>
			</div>
		<% } %>

		<form class="form-cadastro" action="/inserirUsuario" method="POST">
			<div class="row g-3">
				<div class="col-12 col-md-4">
					<label for="nome" class="form-label">Nome</label>
					<input type="text" value="<%= dadosForm.nome %>" class="form-control" id="nome"
						name="nome" placeholder="Nome" required>
				</div>

				<div class="col-12 col-md-4">
					<label for="usuario" class="form-label">Usuário</label>
					<input type="text" value="<%= dadosForm.usuario %>" class="form-control" id="usuario"
						name="usuario" placeholder="Usuário" required>
				</div>

				<div class="col-12 col-md-4">
					<label for="senha" class="form-label">Senha</label>
					<input type="password" value="<%= dadosForm.senha %>" class="form-control" id="senha"
						name="senha" placeholder="Senha" required>
				</div>
			</div>

			<div class="row g-3 center mt-3">
				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_arryn.jpg" class="img-fluid img-radio" alt="Casa Arryn">
					<label class="d-block text-center">
						<input type="radio" id="casa-arryn" name="casa" value="arryn" required> Casa Arryn
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_baratheon.jpg" class="img-fluid img-radio" alt="Casa Baratheon">
					<label class="d-block text-center">
						<input type="radio" id="casa-baratheon" name="casa" value="baratheon" required> Casa Baratheon
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_greyjoy.jpg" class="img-fluid img-radio" alt="Casa Greyjoy">
					<label class="d-block text-center">
						<input type="radio" id="casa-greyjoy" name="casa" value="greyjoy" required> Casa Greyjoy
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_lannister.jpg" class="img-fluid img-radio" alt="Casa Lannister">
					<label class="d-block text-center">
						<input type="radio" id="casa-lannister" name="casa" value="lannister" required> Casa Lannister
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_martell.jpg" class="img-fluid img-radio" alt="Casa Martell">
					<label class="d-block text-center">
						<input type="radio" id="casa-martell" name="casa" value="martell" required> Casa Martell
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_stark.jpg" class="img-fluid img-radio" alt="Casa Stark">
					<label class="d-block text-center">
						<input type="radio" id="casa-stark" name="casa" value="stark" required> Casa Stark
					</label>
				</div>
			</div>

			<div class="row g-3 center mt-3 justify-content-center">
				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_targaryen.jpg" class="img-fluid img-radio" alt="Casa Targaryen">
					<label class="d-block text-center">
						<input type="radio" id="casa-targaryen" name="casa" value="targaryen" required> Casa Targaryen
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_tully.jpg" class="img-fluid img-radio" alt="Casa Tully">
					<label class="d-block text-center">
						<input type="radio" id="casa-tully" name="casa" value="tully" required> Casa Tully
					</label>
				</div>

				<div class="col-6 col-sm-4 col-md-2">
					<img src="images/casa_tyrell.jpg" class="img-fluid img-radio" alt="Casa Tyrell">
					<label class="d-block text-center">
						<input type="radio" id="casa-tyrell" name="casa" value="tyrell" required> Casa Tyrell
					</label>
				</div>
			</div>

			<div class="mt-3">
				<button type="submit" class="btn btn-primary">Confirmar cadastro</button>
			</div>
		</form>
	</div>
</body>

</html>
