<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG - Criar conta</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link rel="stylesheet" href="css/style.css">
</head>

<body class="body-login body-register">
	<%
	const erros = Array.isArray(validacao) ? validacao : [];
	const valores = dadosForm || {};
	const casaSelecionada = valores.casa || '';
	const casas = [
		{ slug: 'arryn', nome: 'Arryn' },
		{ slug: 'baratheon', nome: 'Baratheon' },
		{ slug: 'greyjoy', nome: 'Greyjoy' },
		{ slug: 'lannister', nome: 'Lannister' },
		{ slug: 'martell', nome: 'Martell' },
		{ slug: 'stark', nome: 'Stark' },
		{ slug: 'targaryen', nome: 'Targaryen' },
		{ slug: 'tully', nome: 'Tully' },
		{ slug: 'tyrell', nome: 'Tyrell' }
	];
	%>

	<main class="register-pagina">
		<section class="register-marca">
			<p class="login-eyebrow">A próxima história é sua</p>

			<img class="register-logo" src="images/game_of_thrones_logo.jpg" alt="Game of Thrones">

			<h1>Escolha sua casa.<br>Escreva seu destino.</h1>
			<p class="register-marca__texto">
				Comece com dez aldeões e quinze moedas. Colete recursos, crie seu campeão
				e dispute o Trono de Ferro com os outros senhores.
			</p>

			<ul class="register-destaques">
				<li>Uma casa e um brasão só seus</li>
				<li>Ordens em tempo real e caçadas</li>
				<li>Ranking global de moedas</li>
			</ul>

			<div class="register-casas-faixa" aria-hidden="true">
				<% for (var i = 0; i < casas.length; i++) { %>
					<img src="images/casa_<%=casas[i].slug%>.jpg" alt="">
				<% } %>
			</div>
		</section>

		<section class="register-card" aria-labelledby="register-titulo">
			<header class="register-card__topo">
				<p class="login-card__eyebrow">Primeiro passo</p>
				<h2 id="register-titulo">Criar sua conta</h2>
				<p class="register-card__texto">Preencha seus dados e escolha sua casa.</p>
			</header>

			<% if (erros.length > 0) { %>
				<div class="login-alerta login-alerta--erro" role="alert">
					<strong>Não foi possível criar a conta</strong>
					<ul>
						<% for (var i = 0; i < erros.length; i++) { %>
							<li><%= erros[i].msg %></li>
						<% } %>
					</ul>
				</div>
			<% } %>

			<form class="register-form" action="/inserirUsuario" method="POST">
				<div class="register-campos">
					<div class="register-campo">
						<label for="nome">Nome</label>
						<input type="text" value="<%= valores.nome || '' %>" class="form-control" id="nome"
							name="nome" placeholder="Como devemos chamar você?" autocomplete="name" required>
					</div>

					<div class="register-campo">
						<label for="usuario">Usuário</label>
						<input type="text" value="<%= valores.usuario || '' %>" class="form-control" id="usuario"
							name="usuario" placeholder="Seu nome de acesso" autocomplete="username" required>
					</div>

					<div class="register-campo register-campo--senha">
						<label for="senha">Senha</label>
						<input type="password" value="" class="form-control" id="senha"
							name="senha" placeholder="Crie uma senha" autocomplete="new-password" required>
					</div>
				</div>

				<fieldset class="register-casas-escolha">
					<legend>Escolha sua casa</legend>

					<div class="register-casas-grid">
						<% for (var c = 0; c < casas.length; c++) { %>
							<label class="register-casa">
								<input type="radio" name="casa" value="<%=casas[c].slug%>"
									<%=casaSelecionada === casas[c].slug ? 'checked' : ''%> required>
								<img src="images/casa_<%=casas[c].slug%>.jpg" alt="Brasão da Casa <%=casas[c].nome%>">
								<span>Casa <%=casas[c].nome%></span>
							</label>
						<% } %>
					</div>
				</fieldset>

				<button type="submit" class="btn register-entrar">Criar conta</button>
			</form>

			<p class="register-rodape">
				Já tem uma conta?
				<a href="/">Entrar no reino</a>
			</p>
		</section>
	</main>
</body>

</html>
