
<div id="aldecoes">
	<form class="form-cadastro form-ordens" action="/gerarOrdemSuditos" method="post">
		<input type="hidden" name="jogo" id="jogo" value="<%=JSON.stringify(jogo)%>">
		<input type="hidden" name="acao" id="acao" value="">
		<input type="hidden" name="quantidade" id="quantidade" value="1">

		<h3>Escolha a ordem</h3>

		<div class="cards-acoes">
			<button type="button" class="card-acao" data-acao="1" data-custo="2" data-duracao="10000">
				<img src="images/walk.gif" alt="" loading="lazy">
				<span class="card-acao__titulo">Coletar</span>
				<span class="card-acao__info">2 moedas · 10s/aldeão</span>
			</button>

			<button type="button" class="card-acao" data-acao="2" data-custo="3" data-duracao="120000">
				<img src="images/dead.gif" alt="" loading="lazy">
				<span class="card-acao__titulo">Enforcar</span>
				<span class="card-acao__info">3 moedas · 2min/aldeão</span>
			</button>

			<button type="button" class="card-acao" data-acao="3" data-custo="1" data-duracao="180000">
				<img src="images/book.gif" alt="" loading="lazy">
				<span class="card-acao__titulo">História</span>
				<span class="card-acao__info">1 moeda · 3min/aldeão</span>
			</button>

			<button type="button" class="card-acao" data-acao="4" data-custo="1" data-duracao="240000">
				<img src="images/fire.gif" alt="" loading="lazy">
				<span class="card-acao__titulo">Magia</span>
				<span class="card-acao__info">1 moeda · 4min/aldeão</span>
			</button>

			<button type="button" class="card-acao card-acao--full" data-acao="5" data-custo="5" data-duracao="30000">
				<img src="images/feras/fera.svg" alt="" loading="lazy">
				<span class="card-acao__titulo">Matar a fera</span>
				<span class="card-acao__info">5 moedas · 30s/aldeão · fera surpresa</span>
			</button>

			<button type="button" class="card-acao card-acao--full card-acao--campeao" data-acao="6"
				data-custo="2000" data-duracao="180000">
				<img src="images/icones/campeao.svg" alt="" loading="lazy">
				<span class="card-acao__titulo">Treinar campeão</span>
				<span class="card-acao__info">2.000 moedas · 100 madeira · 50 ferro · 3min</span>
				<span class="card-acao__requisito">Requer 150 temor · 150 sabedoria · 100 magia</span>
			</button>
		</div>

		<div id="painel-ordem" class="painel-ordem d-none">
			<div id="ordem-quantidade">
				<div class="d-flex justify-content-between align-items-center mb-1">
					<label for="qtd-range" class="form-label mb-0">Aldeões enviados</label>
					<strong><span id="qtd-valor">1</span> / <span id="qtd-max">10</span></strong>
				</div>

				<input type="range" class="form-range" id="qtd-range" min="1" max="10" value="1">
			</div>

			<div id="ordem-resumo" class="ordem-resumo"></div>

			<button type="submit" class="btn btn-primary w-100" id="btn-enviar-ordem">Enviar ordem</button>
		</div>

		<p class="form-text mb-2">
			Cada aldeão vale 5 de ataque. As feras têm entre 20 e 50 de vida; o campeão soma +10 de ataque por nível.
		</p>

		<div id="ordem-status" class="ordem-status"></div>
	</form>
</div>
