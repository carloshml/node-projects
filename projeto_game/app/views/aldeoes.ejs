
<div id="aldecoes">
	<h3>Súdito</h3>

	<form class="form-cadastro" action="/gerarOrdemSuditos" method="post">
		<input type="hidden" name="jogo" class="form-control" id="jogo" value="<%=JSON.stringify(jogo)%>">

		<div class="row g-2">
			<div class="col-12 col-sm-9">
				<div class="mb-3">
					<label for="acao" class="form-label">Ação</label>
					<select name="acao" id="acao" class="form-select">
						<option value="">-- Escolha a ação</option>
						<option value="1">Coletar recursos (2 moedas por aldeão, 10s cada)</option>
						<option value="2">Enforcar aldeão (3 moedas por aldeão, 2min cada)</option>
						<option value="3">Ensinar história (1 moeda por aldeão, 3min cada)</option>
						<option value="4">Ensinar magia (1 moeda por aldeão, 4min cada)</option>
						<option value="5">Matar a fera (5 moedas por aldeão, 30s cada) - fera surpresa, mais aldeões = mais força</option>
					</select>
				</div>
			</div>

			<div class="col-12 col-sm-3">
				<div class="mb-3">
					<label for="quantidade" class="form-label">Quantidade</label>
					<input type="number" min="1" name="quantidade" class="form-control" id="quantidade"
						placeholder="Qtd." required>
				</div>
			</div>

			<div class="col-12 col-sm-4">
				<div class="mb-3">
					<button type="submit" class="btn btn-primary">Ordenar</button>
				</div>
			</div>
		</div>

		<hr />

		<div class="row">
			<div class="col-12">
				<span>Senhor, você possui
					<span id="numero-de-suditos-livres"></span> súdito(s) desocupados e
					<span id="numero-de-suditos-trab"></span> súdito(s) em atividade.
				</span>
			</div>
		</div>
	</form>
</div>
