<!DOCTYPE HTML>
<html lang="pt-br">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>MMORPG - Game of Thrones</title>

	<link rel="stylesheet" href="css/bootstrap.min.css">
	<link href="css/style.css" rel="stylesheet">
</head>

<body class="body-login">
	<%
	const erros = Array.isArray(validacao) ? validacao : [];
	const avisos = Array.isArray(aviso) ? aviso : [];
	%>

	<main class="login-pagina">
		<section class="login-marca">
			<p class="login-eyebrow">Os Sete Reinos esperam</p>

			<img class="login-logo" src="images/game_of_thrones_logo.jpg" alt="Game of Thrones">

			<h1>Dispute o Trono de Ferro.</h1>
			<p class="login-marca__texto">
				Comande aldeões, colete recursos e cace feras lendárias para construir
				seu nome entre as grandes casas de Westeros.
			</p>

			<ul class="login-destaques">
				<li>Colete madeira, comida e ferro</li>
				<li>Cace feras e conquiste recompensas</li>
				<li>Dispute o topo do ranking</li>
			</ul>

			<div class="login-casas" aria-label="Casas de Westeros">
				<img src="images/casa_stark.jpg" alt="Casa Stark">
				<img src="images/casa_lannister.jpg" alt="Casa Lannister">
				<img src="images/casa_targaryen.jpg" alt="Casa Targaryen">
				<img src="images/casa_baratheon.jpg" alt="Casa Baratheon">
				<img src="images/casa_martell.jpg" alt="Casa Martell">
			</div>
		</section>

		<section class="login-card" aria-labelledby="login-titulo">
			<header class="login-card__topo">
				<p class="login-card__eyebrow">Bem-vindo de volta</p>
				<h2 id="login-titulo">Entrar no reino</h2>
				<p class="login-card__texto">Use sua conta para retomar sua jornada.</p>
			</header>

			<% if (erros.length > 0) { %>
				<div class="login-alerta login-alerta--erro" role="alert">
					<strong>Não foi possível entrar</strong>
					<ul>
						<% for (var i = 0; i < erros.length; i++) { %>
							<li><%= erros[i].msg %></li>
						<% } %>
					</ul>
				</div>
			<% } %>

			<% if (avisos.length > 0) { %>
				<div class="login-alerta login-alerta--sucesso" role="status">
					<strong>Tudo certo</strong>
					<ul>
						<% for (var i = 0; i < avisos.length; i++) { %>
							<li><%= avisos[i].msg %></li>
						<% } %>
					</ul>
				</div>
			<% } %>

			<form class="login-form" action="/autenticar" method="POST">
				<div class="login-campo">
					<label for="usuario">Usuário</label>
					<input type="text" name="usuario" id="usuario" class="form-control"
						placeholder="Seu nome de usuário" autocomplete="username" autofocus required>
				</div>

				<div class="login-campo">
					<label for="senha">Senha</label>
					<input type="password" name="senha" id="senha" class="form-control"
						placeholder="Sua senha" autocomplete="current-password" required>
				</div>

				<button type="submit" class="btn login-entrar">Entrar</button>
			</form>

			<div class="login-divisor"><span>ou</span></div>

			<a href="/cadastro" class="btn login-cadastro">Criar uma conta</a>

			<p class="login-rodape">Escolha sua casa e comece sua história.</p>
		</section>
	</main>
</body>

</html>
